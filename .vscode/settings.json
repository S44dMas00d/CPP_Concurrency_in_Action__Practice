{
    // --- Formatting -------------------------------------------------------
    // Two extensions here can format C++ (ms-vscode.cpptools and
    // chiehyu.vscode-astyle). When more than one claims the language VS Code
    // refuses to guess and silently does nothing on save, so name the winner
    // explicitly per-language.
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    "editor.formatOnSave": true,
    "C_Cpp.formatting": "clangFormat",
    // "file" = walk up from the edited file until a .clang-format is found,
    // i.e. the one in the repo root.
    "C_Cpp.clang_format_style": "file",
    // cpptools ships its own clang-format (currently 22.x). The repo's
    // .clang-format was generated by clang-format 14 and still carries keys
    // that 14 understood (AllowAllConstructorInitializersOnNextLine,
    // ConstructorInitializerAllOnOneLineOrOnePerLine, IndentRequires), so pin
    // the system binary to keep editor output identical to `clang-format` on
    // the command line.
    "C_Cpp.clang_format_path": "/usr/bin/clang-format",
    // --- IntelliSense -----------------------------------------------------
    // CMakeLists.txt sets CMAKE_EXPORT_COMPILE_COMMANDS, so point cpptools at
    // the generated database instead of letting it guess include paths.
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
    "C_Cpp.default.cppStandard": "c++17",
    // --- CMake Tools ------------------------------------------------------
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.buildDirectory": "${workspaceFolder}/build",
    // Must stay true. CMake Tools builds its target lists (the build and
    // launch/debug target pickers, and ${command:cmake.launchTargetPath} used
    // in launch.json) purely from a CMake File API codemodel, and that
    // codemodel only exists once *CMake Tools itself* has configured. A plain
    // `cmake -S . -B build` from a shell task populates build/ but writes no
    // File API query, so the pickers stay empty.
    "cmake.configureOnOpen": true,
    // Generator deliberately NOT pinned here. CMake Tools defaults to Ninja
    // (what the working DSA project uses); setting cmake.generator made
    // selectLaunchTarget fail with "No usable generator found". tasks.json
    // passes -G Ninja so the shell task and CMake Tools still agree.
    "files.associations": {
        "*.hpp": "cpp"
    }
}